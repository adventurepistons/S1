# =============================================================================
# Test Automation Copilot - Backend Environment Configuration
# =============================================================================

# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testcopilot

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
# ⚠️  CRITICAL: Generate a strong secret for production using: openssl rand -base64 64
# ⚠️  Must be at least 32 characters long
# ⚠️  NEVER commit the actual production secret to version control
JWT_SECRET=your-super-secret-jwt-key-change-in-production-MINIMUM-32-CHARACTERS
JWT_EXPIRES_IN=3600  # 1 hour in seconds
REFRESH_TOKEN_EXPIRES_IN=604800  # 7 days in seconds (reduced from 30 days for security)

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# OAuth (GitHub)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# AWS S3 (for screenshots, videos, files)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=testcopilot-dev
AWS_REGION=us-east-1

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_ID_TEAM_MONTHLY=price_team_monthly

# SendGrid (Email)
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@testcopilot.dev
SENDGRID_FROM_NAME=Test Copilot

# CORS - Comma-separated list of allowed origins
# For production, add your production domain: https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_TTL=60  # seconds
RATE_LIMIT_MAX_FREE=10  # requests per TTL
RATE_LIMIT_MAX_PRO=60
RATE_LIMIT_MAX_TEAM=300

# Encryption (for storing user API keys)
ENCRYPTION_KEY=your-32-byte-encryption-key-here  # Generate with: openssl rand -hex 32

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Feature Flags
ENABLE_VISUAL_TESTING=true
ENABLE_API_TESTING=true
ENABLE_TEAM_FEATURES=true

# Monitoring (Optional)
SENTRY_DSN=
DATADOG_API_KEY=

# Logging
LOG_LEVEL=debug  # debug, info, warn, error
